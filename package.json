{
  "name": "bili-comment-memory",
  "version": "0.3.3",
  "description": "BiliMemo：随浏览记录 B 站可见评论，在本机回看跨视频发言的浏览器扩展。",
  "license": "MIT",
  "author": "wzp100",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzp100/bili-comment-memory.git"
  },
  "homepage": "https://github.com/wzp100/bili-comment-memory#readme",
  "bugs": {
    "url": "https://github.com/wzp100/bili-comment-memory/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "^1.58.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  }
}
